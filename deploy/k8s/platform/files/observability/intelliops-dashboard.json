        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "A",
          "expr": "latency_p99_ms",
          "legendFormat": "{{service}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
