        }
      }
    },
    {
      "type": "timeseries",
      "title": "Service up",
      "description": "1 = serving, 0 = down. Scraped from each Meridian service and the demo app.",
      "id": 7,
      "gridPos": {
        "x": 12,
        "y": 30,
        "w": 12,
        "h": 7
      },
      "datasource": {
        "type": "prometheus",
