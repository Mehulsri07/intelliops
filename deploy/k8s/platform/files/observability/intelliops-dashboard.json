    {
      "type": "row",
      "title": "Governance (Postgres)",
      "id": 102,
      "gridPos": {
        "x": 0,
        "y": 37,
        "w": 24,
        "h": 1
      },
      "collapsed": false
    },
    {
      "type": "table",
      "title": "Audit trail",
      "description": "The durable audit log (audit_records): every diagnosis, approval, remediation and graduation - the latest 500, whatever the time range. Empty when STORE_BACKEND=file.",
      "id": 8,
      "gridPos": {
        "x": 0,
        "y": 38,
        "w": 24,
        "h": 12
      },
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "intelliops-postgres"
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "intelliops-postgres"
          },
          "refId": "A",
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "SELECT ts AS \"time\", actor, action, resource, decision, correlation_id FROM audit_records ORDER BY ts DESC LIMIT 500"
        }
      ],
      "options": {
        "showHeader": true,
        "cellHeight": "sm"
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      }
    }
  ]
}
