# Copy to deploy/.env (gitignored) and fill in. Compose substitutes these.
# Any OpenAI-compatible endpoint: OpenAI, Groq, vLLM, Ollama, ...
#
#   OpenAI : https://api.openai.com/v1        model gpt-4o-mini
#   Groq   : https://api.groq.com/openai/v1   model openai/gpt-oss-120b
#
# Leave INTELLIOPS_LLM_ENDPOINT empty to keep the offline template provider
# (no network, deterministic) - that is the default posture.
INTELLIOPS_LLM_ENDPOINT=
INTELLIOPS_LLM_MODEL=gpt-4o-mini
INTELLIOPS_LLM_API_KEY=
INTELLIOPS_LLM_TIMEOUT_SECONDS=30

# "off" | "openai". The agentic runbook author needs a tool-calling model.
INTELLIOPS_RUNBOOK_AUTHOR_MODE=off
